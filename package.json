{
  "name": "certnotify",
  "version": "0.1.0",
  "description": "Open-source internet exposure scanner — SSL/TLS, DNS, DNSSEC, email security (SPF/DKIM/DMARC), HTTP security headers, open ports, DNSBL reputation, and uptime, from the command line.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "certnotify": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:unit": "vitest run test/ssrfGuard.test.ts test/headers-grading.test.ts test/score.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "keywords": [
    "security",
    "ssl",
    "tls",
    "dns",
    "dnssec",
    "dmarc",
    "spf",
    "dkim",
    "security-headers",
    "port-scanner",
    "attack-surface",
    "devsecops",
    "cli"
  ],
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/siddhantmallah/certnotify-community.git"
  },
  "homepage": "https://www.certnotify.com",
  "dependencies": {
    "commander": "^15.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
